{
  "name": "excalidrop",
  "version": "0.2.4",
  "description": "Remote GitHub-backed Excalidraw canvas + MCP server — no local server, one-command setup",
  "main": "dist/mcp.js",
  "type": "module",
  "bin": {
    "excalidrop": "dist/cli.js"
  },
  "scripts": {
    "start": "npm run build:server && node dist/mcp.js --repo=$EXCALIDROP_REPO",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "npx tsc",
    "build:types": "npx tsc --emitDeclarationOnly",
    "dev": "concurrently \"npm run dev:server\" \"vite\"",
    "dev:server": "npx tsc --watch",
    "prepare": "npm run build",
    "excalidrop": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "type-check": "npx tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@modelcontextprotocol/sdk": "latest",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^1.1.3",
    "@types/node": "^20.19.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "mermaid": "^11.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "keywords": [
    "excalidrop",
    "excalidraw",
    "model-context-protocol",
    "ai",
    "drawing",
    "diagrams",
    "canvas",
    "real-time",
    "websocket",
    "visualization",
    "claude",
    "ai-tools"
  ],
  "author": "yctimlin <c22647809@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wtf403/excalidrop.git"
  },
  "homepage": "https://github.com/wtf403/excalidrop#readme",
  "bugs": {
    "url": "https://github.com/wtf403/excalidrop/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "vite.config.js"
  ],
  "directories": {
    "doc": "docs"
  },
  "types": "./dist/mcp.d.ts"
}
